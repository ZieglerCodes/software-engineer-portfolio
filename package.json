{
  "name": "software-engineer-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adam Ziegler's software engineering portfolio featuring full stack, AI, desktop, and product engineering projects.",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"**/*.{js,mjs,cjs,jsx,ts,tsx,astro}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "astro check",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
