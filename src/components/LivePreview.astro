---
interface Props {
  title: string;
  url: string;
  enabled?: boolean;
}

const { title, url, enabled = false } = Astro.props;

const parsedUrl = new URL(url);

const host = parsedUrl.hostname.replace('www.', '');
---

<div
  class="overflow-hidden
    border-b
    border-slate-800
    bg-slate-950"
>
  <div
    class="flex
      h-12
      items-center
      gap-3
      border-b
      border-slate-800
      bg-[#111720]
      px-4"
  >
    <div
      aria-hidden="true"
      class="flex
        shrink-0
        gap-1.5"
    >
      <span
        class="size-2.5
          rounded-full
          bg-red-400/75"
      ></span>

      <span
        class="size-2.5
          rounded-full
          bg-amber-400/75"
      ></span>

      <span
        class="size-2.5
          rounded-full
          bg-emerald-400/75"
      ></span>
    </div>

    <div
      class="flex
        min-w-0
        flex-1
        items-center
        gap-2
        rounded-md
        border
        border-slate-800
        bg-slate-950
        px-3
        py-1.5"
    >
      <span
        aria-hidden="true"
        class="size-1.5
          shrink-0
          rounded-full
          bg-emerald-400"
      ></span>

      <span
        class="min-w-0
          truncate
          font-mono
          text-[11px]
          text-slate-500"
      >
        https://{host}
      </span>
    </div>

    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Open ${title} in a new tab`}
      class="hidden
        shrink-0
        text-xs
        font-semibold
        text-slate-500
        transition
        hover:text-white
        sm:block"
    >
      Open ↗
    </a>
  </div>

  {enabled ? (
    <div
      class="relative
          h-[280px]
          overflow-hidden
          bg-white
          sm:h-[380px]
          lg:h-[460px]"
    >
      <iframe
        src={url}
        title={`${title} live website preview`}
        loading="lazy"
        tabindex="-1"
        referrerpolicy="strict-origin-when-cross-origin"
        class="pointer-events-none
            h-full
            w-full
            border-0
            bg-white"
      >
        </iframe>

      <div
        class="pointer-events-none
            absolute
            left-4
            top-4
            inline-flex
            items-center
            gap-2
            rounded-full
            border
            border-emerald-400/20
            bg-slate-950/90
            px-3
            py-1.5
            text-xs
            font-semibold
            text-emerald-300
            shadow-lg
            backdrop-blur-md"
      >
        <span
          aria-hidden="true"
          class="size-1.5
              rounded-full
              bg-emerald-400
              shadow-[0_0_10px_rgba(52,211,153,0.7)]"
        ></span>
        Live Preview
      </div>

      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute
            bottom-4
            right-4
            inline-flex
            min-h-11
            items-center
            justify-center
            rounded-lg
            border
            border-slate-600
            bg-slate-950/95
            px-4
            text-sm
            font-semibold
            text-white
            shadow-xl
            backdrop-blur-md
            transition
            hover:border-sky-400
            hover:bg-slate-900"
      >
        Explore Live Site ↗
      </a>

      <div
        aria-hidden="true"
        class="pointer-events-none
            absolute
            inset-x-0
            bottom-0
            h-16
            bg-gradient-to-t
            from-slate-950/25
            to-transparent"
      ></div>
    </div>
  ) : (
    <div
      class="relative
          flex
          min-h-[280px]
          items-center
          justify-center
          overflow-hidden
          bg-[#090d13]
          p-7
          sm:min-h-[360px]
          sm:p-10"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none
            absolute
            inset-0
            opacity-[0.06]
            [background-image:linear-gradient(to_right,#38bdf8_1px,transparent_1px),linear-gradient(to_bottom,#38bdf8_1px,transparent_1px)]
            [background-size:36px_36px]"
      ></div>

      <div
        aria-hidden="true"
        class="pointer-events-none
            absolute
            left-1/2
            top-1/2
            size-80
            -translate-x-1/2
            -translate-y-1/2
            rounded-full
            bg-sky-400/10
            blur-[100px]"
      ></div>

      <div
        class="relative
            w-full
            max-w-xl
            text-center"
      >
        <div
          class="mx-auto
              flex
              size-14
              items-center
              justify-center
              rounded-2xl
              border
              border-sky-400/20
              bg-sky-400/10"
        >
          <span
            aria-hidden="true"
            class="text-xl
                text-sky-300"
          >
            ↗
          </span>
        </div>

        <div
          class="mt-6
              inline-flex
              items-center
              gap-2
              rounded-full
              border
              border-emerald-400/20
              bg-emerald-400/5
              px-3
              py-1.5"
        >
          <span
            aria-hidden="true"
            class="size-1.5
                rounded-full
                bg-emerald-400"
          ></span>

          <span
            class="font-mono
                text-[11px]
                font-semibold
                uppercase
                tracking-[0.14em]
                text-emerald-300"
          >
            Live Product
          </span>
        </div>

        <h4
          class="mt-5
              text-3xl
              font-semibold
              tracking-tight
              text-white"
        >
          {title}
        </h4>

        <p
          class="mt-3
              font-mono
              text-sm
              text-slate-500"
        >
          {host}
        </p>

        <p
          class="mx-auto
              mt-5
              max-w-md
              text-sm
              leading-6
              text-slate-500"
        >
          This application is deployed and available to explore live.
        </p>

        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7
              inline-flex
              min-h-12
              items-center
              justify-center
              rounded-lg
              bg-sky-400
              px-5
              text-sm
              font-semibold
              text-slate-950
              shadow-lg
              shadow-sky-950/30
              transition
              hover:bg-sky-300"
        >
          Launch Live Product ↗
        </a>
      </div>
    </div>
  )}
</div>
