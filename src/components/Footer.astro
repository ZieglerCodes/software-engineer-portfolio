---
import { emailHref, phoneHref, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-[#070a0f]">
  <div class="mx-auto max-w-7xl px-5 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <div class="flex items-center gap-3">
          <span class="flex size-9 items-center justify-center rounded-lg border border-slate-700 bg-slate-900 font-mono text-sm font-semibold text-sky-400">
            {site.initials}
          </span>

          <div>
            <p class="font-semibold text-white">{site.name}</p>

            <p class="mt-1 text-sm text-slate-500">{site.role}</p>
          </div>
        </div>

        <p class="mt-5 max-w-md text-sm leading-6 text-slate-500">
          Building software around real problems in sales, real estate, lead generation, and AI
          powered workflows.
        </p>
      </div>

      <nav
        aria-label="Footer navigation"
        class="flex flex-wrap gap-x-5 gap-y-3 text-sm md:justify-end"
      >
        <a href="#projects" class="text-slate-400 transition hover:text-white">
          Projects
        </a>

        <a href="#engineering" class="text-slate-400 transition hover:text-white">
          Engineering
        </a>

        <a href="#about" class="text-slate-400 transition hover:text-white">
          About
        </a>

        <a href="#contact" class="text-slate-400 transition hover:text-white">
          Contact
        </a>
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-6 border-t border-slate-800 pt-6 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
        <a href={emailHref} class="text-slate-400 transition hover:text-white">
          Email
        </a>

        <a href={phoneHref} class="text-slate-400 transition hover:text-white">
          {site.phoneDisplay}
        </a>

        <a
          href={site.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-400 transition hover:text-white"
        >
          LinkedIn ↗
        </a>

        <a
          href={site.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-400 transition hover:text-white"
        >
          GitHub ↗
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-5 text-xs text-slate-600">
        <span>
          © {year} {site.name}
        </span>

        <span aria-hidden="true" class="hidden sm:inline">
          •
        </span>

        <span>Built with Astro + TypeScript</span>

        <a href="#top" class="font-medium text-slate-500 transition hover:text-white">
          Back to top ↑
        </a>
      </div>
    </div>
  </div>
</footer>
