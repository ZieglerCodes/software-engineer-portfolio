---
import LivePreview from './LivePreview.astro';

import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const isComplete = project.status === 'Complete';

const statusClasses = isComplete
  ? 'border-emerald-400/25 bg-emerald-400/10 text-emerald-300'
  : 'border-sky-400/25 bg-sky-400/10 text-sky-300';

const statusDotClasses = isComplete
  ? 'bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.65)]'
  : 'bg-sky-400 shadow-[0_0_10px_rgba(56,189,248,0.55)]';
---

<article
  class:list={[
    `
      group
      overflow-hidden
      rounded-3xl
      border
      bg-[#0c1119]
      shadow-2xl
      shadow-black/10
      transition
      duration-300
    `,
    project.featured
      ? 'border-sky-400/30 shadow-sky-950/20'
      : 'border-slate-800 hover:border-slate-700',
  ]}
>
  <LivePreview
    title={project.name}
    url={project.previewUrl ?? project.liveUrl}
    enabled={project.previewMode === 'iframe'}
  />

  <div
    class="p-6
      sm:p-8
      lg:p-10"
  >
    <div
      class="grid
        gap-10
        lg:grid-cols-[0.82fr_1.18fr]
        lg:gap-12"
    >
      <!-- PROJECT OVERVIEW -->
      <div>
        <div
          class="flex
            flex-wrap
            items-center
            gap-3"
        >
          <span
            class:list={[
              `
                inline-flex
                items-center
                gap-2
                rounded-full
                border
                px-3
                py-1
                text-xs
                font-semibold
              `,
              statusClasses,
            ]}
          >
            <span
              aria-hidden="true"
              class:list={[
                `
                  size-1.5
                  rounded-full
                `,
                statusDotClasses,
              ]}
            ></span>

            {project.status}
          </span>

          {project.featured && (
            <span
              class="rounded-full
                  border
                  border-slate-700
                  bg-slate-900
                  px-3
                  py-1
                  text-xs
                  font-medium
                  text-slate-400"
            >
              Featured Project
            </span>
          )}
        </div>

        <p
          class="mt-6
            font-mono
            text-xs
            font-semibold
            uppercase
            tracking-[0.14em]
            text-sky-400"
        >
          {project.eyebrow}
        </p>

        <h3
          class="mt-3
            text-3xl
            font-semibold
            tracking-tight
            text-white
            sm:text-4xl"
        >
          {project.name}
        </h3>

        <p
          class="mt-5
            max-w-xl
            text-base
            leading-7
            text-slate-400"
        >
          {project.description}
        </p>

        {project.technologies.length > 0 && (
          <div class="mt-7">
            <p
              class="font-mono
                  text-[11px]
                  font-semibold
                  uppercase
                  tracking-[0.14em]
                  text-slate-600"
            >
              Built With
            </p>

            <ul
              aria-label={`${project.name} technologies`}
              class="mt-3
                  flex
                  flex-wrap
                  gap-2"
            >
              {project.technologies.map((technology) => (
                <li
                  class="rounded-md
                          border
                          border-slate-800
                          bg-slate-950
                          px-2.5
                          py-1.5
                          text-xs
                          font-medium
                          text-slate-400"
                >
                  {technology}
                </li>
              ))}
            </ul>
          </div>
        )}

        <div
          class="mt-8
            flex
            flex-wrap
            gap-3"
        >
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex
              min-h-11
              items-center
              justify-center
              rounded-lg
              bg-sky-400
              px-4
              text-sm
              font-semibold
              text-slate-950
              transition
              hover:bg-sky-300"
          >
            Open Live Product ↗
          </a>

          {project.repoUrl && (
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex
                  min-h-11
                  items-center
                  justify-center
                  rounded-lg
                  border
                  border-slate-700
                  bg-slate-900
                  px-4
                  text-sm
                  font-semibold
                  text-white
                  transition
                  hover:border-slate-500
                  hover:bg-slate-800"
            >
              {project.repoLabel ?? 'Source Code'} ↗
            </a>
          )}
        </div>
      </div>

      <!-- BUSINESS STORY -->
      <div
        class="grid
          gap-4
          sm:grid-cols-2"
      >
        <section
          class="relative
            overflow-hidden
            rounded-2xl
            border
            border-slate-800
            bg-slate-950/60
            p-6"
        >
          <div
            aria-hidden="true"
            class="absolute
              -right-10
              -top-10
              size-28
              rounded-full
              bg-sky-400/5
              blur-3xl"
          ></div>

          <div class="relative">
            <span
              class="font-mono
                text-xs
                text-sky-400"
            >
              01
            </span>

            <p
              class="mt-4
                font-mono
                text-xs
                font-semibold
                uppercase
                tracking-[0.14em]
                text-slate-500"
            >
              The Business Problem
            </p>

            <p
              class="mt-4
                text-sm
                leading-7
                text-slate-300"
            >
              {project.businessProblem}
            </p>
          </div>
        </section>

        <section
          class="relative
            overflow-hidden
            rounded-2xl
            border
            border-slate-800
            bg-slate-950/60
            p-6"
        >
          <div
            aria-hidden="true"
            class="absolute
              -bottom-10
              -left-10
              size-28
              rounded-full
              bg-emerald-400/5
              blur-3xl"
          ></div>

          <div class="relative">
            <span
              class="font-mono
                text-xs
                text-emerald-400"
            >
              02
            </span>

            <p
              class="mt-4
                font-mono
                text-xs
                font-semibold
                uppercase
                tracking-[0.14em]
                text-slate-500"
            >
              What I Built
            </p>

            <p
              class="mt-4
                text-sm
                leading-7
                text-slate-300"
            >
              {project.solution}
            </p>
          </div>
        </section>

        {project.note && (
          <div
            class="sm:col-span-2
                rounded-xl
                border
                border-slate-800/70
                bg-slate-950/30
                px-4
                py-3"
          >
            <p
              class="flex
                  gap-2
                  text-xs
                  leading-5
                  text-slate-500"
            >
              <span
                aria-hidden="true"
                class="shrink-0
                    text-sky-500"
              >
                ●
              </span>

              <span>{project.note}</span>
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
</article>
